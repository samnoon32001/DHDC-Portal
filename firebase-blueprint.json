{
  "entities": {
    "User": {
      "title": "User",
      "description": "System user account with role-based access",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "teacher", "student"] },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "admissionNumber": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "username", "role", "name", "status"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record enrolled in a class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "admissionNumber": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "userId": { "type": "string" },
        "classId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "admissionNumber", "name", "classId", "status"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher profile with subject, class, and class teacher responsibilities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "assignedSubjectIds": { "type": "array" },
        "assignedClassIds": { "type": "array" },
        "classTeacherOfClassIds": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "status"]
    },
    "Class": {
      "title": "Class",
      "description": "School grade / division class",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "academicYear": { "type": "string" },
        "classTeacherId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "subjectIds": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "academicYear", "status"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic subject offered in classes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "classId": { "type": "string" },
        "assignedTeacherId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "code", "status"]
    },
    "EvaluationLevel": {
      "title": "EvaluationLevel",
      "description": "Continuous and Comprehensive Evaluation level for a subject",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subjectId": { "type": "string" },
        "name": { "type": "string" },
        "maximumMark": { "type": "number" },
        "displayOrder": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "subjectId", "name", "maximumMark"]
    },
    "Mark": {
      "title": "Mark",
      "description": "Evaluation level mark scored by a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "classId": { "type": "string" },
        "subjectId": { "type": "string" },
        "evaluationLevelId": { "type": "string" },
        "maximumMark": { "type": "number" },
        "obtainedMark": { "type": "number" },
        "date": { "type": "string" },
        "enteredBy": { "type": "string" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "studentId", "subjectId", "evaluationLevelId", "maximumMark", "obtainedMark"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System activity and mark audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "role": { "type": "string" },
        "action": { "type": "string" },
        "entity": { "type": "string" },
        "entityId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "action", "entity", "timestamp"]
    },
    "ShowcaseCard": {
      "title": "ShowcaseCard",
      "description": "Showcase and topper spotlight announcement cards with priorities and audience targeting",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "studentName": { "type": "string" },
        "studentAdmissionNumber": { "type": "string" },
        "studentId": { "type": "string" },
        "percentage": { "type": "string" },
        "scoreDetails": { "type": "string" },
        "sectionOrClass": { "type": "string" },
        "classId": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "number" },
        "badgeText": { "type": "string" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" },
        "accentGradient": { "type": "string" },
        "targetAudience": { "type": "string" },
        "targetRoles": { "type": "array" },
        "targetClassIds": { "type": "array" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "examName": { "type": "string" },
        "academicYear": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" }
      },
      "required": ["id", "title", "studentName", "percentage", "priority", "order", "isActive"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User credentials and role profiles"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student details and class enrollments"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Teacher records and teaching assignments"
    },
    "/classes/{classId}": {
      "schema": "Class",
      "description": "Class grade divisions"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Curriculum subjects with assigned teachers"
    },
    "/evaluation_levels/{levelId}": {
      "schema": "EvaluationLevel",
      "description": "CCE evaluation components and max marks"
    },
    "/marks/{markId}": {
      "schema": "Mark",
      "description": "Student evaluation marks and timestamps"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit trails for marks and system modifications"
    },
    "/showcase_cards/{cardId}": {
      "schema": "ShowcaseCard",
      "description": "Showcase banner and topper cards for user dashboards"
    }
  }
}
